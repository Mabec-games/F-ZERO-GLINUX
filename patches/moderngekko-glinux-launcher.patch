+bool SetBoostLayout(const fs::path &user_directory, bool enabled, std::string *error) {
+  const auto path = user_directory / "Config" / "GCPadNew.ini";
+  std::ifstream input(path);
+  if (!input) {
+    if (error) *error = "Generate a GameCube controller profile first.";
+    return false;
+  }
+  std::string result, line, section;
+  int x_count = 0, y_count = 0;
+  while (std::getline(input, line)) {
+    const auto trimmed = Trim(line);
+    if (trimmed.starts_with('[')) section = trimmed;
+    const bool pad = section == "[GCPad1]" || section == "[GCPad2]" ||
+                     section == "[GCPad3]" || section == "[GCPad4]";
+    const auto equals = trimmed.find('=');
+    const auto key = equals == std::string::npos ? "" : Trim(trimmed.substr(0, equals));
+    if (pad && (key == "Buttons/X" || key == "Buttons/Y")) {
+      const auto value = Trim(trimmed.substr(equals + 1));
+      if (value != "`Button X`" && value != "`Button Y`") {
+        if (error) *error = "Custom X/Y bindings detected; edit those manually or generate a standard profile.";
+        return false;
+      }
+      const bool is_x = key == "Buttons/X";
+      if (is_x) ++x_count; else ++y_count;
+      line = key + " = `Button " + ((is_x != enabled) ? "X`" : "Y`");
+    }
+    result += line + '\n';
+  }
+  if (input.bad() || x_count == 0 || x_count != y_count) {
+    if (error) *error = "Incomplete GameCube X/Y bindings; profile was not changed.";
+    return false;
+  }
+  const auto temporary = path.string() + ".glinux-tmp";
