new file mode 100644
index 0000000..e07c356
--- /dev/null
+++ b/tests/netplay_room_code_test.cpp
@@ -0,0 +1,50 @@
+#include "netplay_room_code.hpp"
+
+#include <cstdio>
+#include <set>
+#include <string>
+
+namespace {
+bool Fail(const char *message) {
+  std::fprintf(stderr, "%s\n", message);
+  return false;
+}
+
+bool Run() {
+  std::set<std::string> first_words;
+  for (unsigned int byte = 0; byte < 256; ++byte) {
+    char host_code[9];
+    std::snprintf(host_code, sizeof(host_code), "%02x%02x%02x%02x", byte,
+                  255 - byte, (byte * 7) & 0xff, (byte * 13) & 0xff);
+    const auto encoded = moderngekko::frontend::EncodeRoomCode(host_code);
+    if (!encoded)
+      return Fail("valid host code was not encoded");
+    if (moderngekko::frontend::DecodeRoomCode(*encoded) != host_code)
+      return Fail("room code did not round-trip");
+    first_words.insert(encoded->substr(0, encoded->find('-')));
+  }
+  if (first_words.size() != 256)
+    return Fail("room code words are not unique");
+
+  const auto encoded = moderngekko::frontend::EncodeRoomCode("00ff10ab");
+  if (!encoded)
+    return Fail("example host code was not encoded");
+  std::string relaxed;
+  for (const char c : *encoded)
+    relaxed += c == '-' ? ' ' : static_cast<char>(c | 0x20);
+  if (moderngekko::frontend::DecodeRoomCode("  " + relaxed + " ") != "00ff10ab")
+    return Fail("lowercase, space-separated room code was rejected");
+
+  if (moderngekko::frontend::EncodeRoomCode("00ff10a") ||
+      moderngekko::frontend::EncodeRoomCode("00ff10ag"))
+    return Fail("malformed host code was encoded");
+  if (moderngekko::frontend::DecodeRoomCode("192.168.1.50") ||
+      moderngekko::frontend::DecodeRoomCode("localhost") ||
+      moderngekko::frontend::DecodeRoomCode("FALCON-PICO-SAMURAI") ||
+      moderngekko::frontend::DecodeRoomCode("FALCON-PICO-SAMURAI-NOTAWORD"))
+    return Fail("non-room-code text was decoded");
+  return true;
+}
+} // namespace
+
+int main() { return Run() ? 0 : 1; }
