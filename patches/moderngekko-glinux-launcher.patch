+#include "graphics_mods.hpp"
+
+#include <picojson.h>
+
+#include <algorithm>
+#include <fstream>
+#include <iterator>
+#include <set>
+
+namespace fs = std::filesystem;
+
+namespace moderngekko::frontend {
+namespace {
+// Mod folders are linked into the Load folders, so scans follow links.
+constexpr auto kScanOptions = fs::directory_options::skip_permission_denied |
+                              fs::directory_options::follow_directory_symlink;
+
+fs::path ModListPath(const fs::path &user_directory) {
+  return user_directory / "Config" / "glinux-mods.txt";
+}
+
+fs::path LoadFolder(const fs::path &user_directory, std::string_view game_id,
+                    ModKind kind) {
+  return kind == ModKind::TexturePack
+             ? TexturePackDirectory(user_directory, game_id)
+             : GraphicsModDirectory(user_directory, game_id);
+}
+
+// Returns folder/name, or folder/"name (2)" and so on when that is taken.
+fs::path FreeName(const fs::path &folder, const fs::path &name) {
+  std::error_code error;
+  fs::path candidate = folder / name;
+  for (int i = 2; fs::exists(fs::symlink_status(candidate, error)); ++i)
+    candidate = folder / (name.string() + " (" + std::to_string(i) + ")");
+  return candidate;
+}
+
+fs::path ProfilePath(const fs::path &user_directory, std::string_view game_id) {
+  return user_directory / "Config" / "GraphicMods" /
+         (std::string(game_id) + ".json");
+}
+
+// Mirrors Dolphin's GetTextureDirectoriesWithGameId: a folder named after the
+// game (or its region-free prefix), plus any top-level folder holding a
+// <game id>.txt, <prefix>.txt or all.txt marker.
+std::set<fs::path> ModDirectories(const fs::path &root,
+                                  std::string_view game_id) {
+  std::set<fs::path> result;
+  std::error_code error;
+  const std::string id(game_id);
+  const std::string prefix = id.substr(0, 3);
+  if (fs::is_directory(root / id, error))
+    result.insert(root / id);
+  else if (fs::is_directory(root / prefix, error))
+    result.insert(root / prefix);
+
+  if (!fs::is_directory(root, error))
+    return result;
+  for (auto it = fs::recursive_directory_iterator(
+           root, kScanOptions, error);
+       !error && it != fs::recursive_directory_iterator(); it.increment(error)) {
+    const fs::path &file = it->path();
+    if (file.extension() != ".txt")
+      continue;
+    const std::string stem = file.stem().string();
+    if (stem != id && stem != prefix && stem != "all")
+      continue;
+    const fs::path relative = file.lexically_relative(root);
+    result.insert(root / *relative.begin());
+  }
+  return result;
+}
+
+std::string MetaString(const picojson::value &meta, const char *key) {
+  const picojson::value &value = meta.get(key);
+  return value.is<std::string>() ? value.get<std::string>() : std::string();
+}
+
+bool ReadJson(const fs::path &path, picojson::value *root) {
+  std::ifstream file(path);
+  if (!file)
+    return false;
+  const std::string text{std::istreambuf_iterator<char>(file), {}};
+  return picojson::parse(*root, text).empty();
+}
+
+std::string ProfileKey(bool system, std::string_view path) {
+  return (system ? "system:" : "user:") + std::string(path);
+}
+} // namespace
+
+fs::path TexturePackDirectory(const fs::path &user_directory,
+                              std::string_view game_id) {
+  return user_directory / "Load" / "Textures" / std::string(game_id);
+}
+
+fs::path GraphicsModDirectory(const fs::path &user_directory,
+                              std::string_view game_id) {
+  return user_directory / "Load" / "GraphicMods" / std::string(game_id);
+}
+
+std::vector<GraphicsMod> ListGraphicsMods(const fs::path &user_directory,
+                                          const fs::path &sys_directory,
+                                          std::string_view game_id) {
+  std::set<std::string> enabled;
+  picojson::value profile;
+  if (ReadJson(ProfilePath(user_directory, game_id), &profile) &&
+      profile.get("mods").is<picojson::array>()) {
+    for (const picojson::value &entry : profile.get("mods").get<picojson::array>()) {
+      if (entry.get("enabled").is<bool>() && entry.get("enabled").get<bool>() &&
+          entry.get("path").is<std::string>())
+        enabled.insert(ProfileKey(entry.get("source").to_str() == "system",
+                                  entry.get("path").get<std::string>()));
+    }
+  }
+
+  std::vector<GraphicsMod> mods;
+  const auto add_mods = [&](const fs::path &root, bool system) {
+    for (const fs::path &directory : ModDirectories(root, game_id)) {
+      std::error_code error;
+      for (auto it = fs::recursive_directory_iterator(directory, kScanOptions, error);
+           !error && it != fs::recursive_directory_iterator();
+           it.increment(error)) {
+        if (it->path().filename() != "metadata.json")
+          continue;
+        picojson::value metadata;
+        if (!ReadJson(it->path(), &metadata) || !metadata.is<picojson::object>())
+          continue;
+        GraphicsMod mod;
+        const picojson::value &meta = metadata.get("meta");
+        mod.title = MetaString(meta, "title");
+        mod.author = MetaString(meta, "author");
+        mod.description = MetaString(meta, "description");
+        mod.system = system;
+        mod.path = it->path().lexically_relative(root).generic_string();
+        if (mod.title.empty())
+          mod.title = it->path().parent_path().filename().string();
+        mod.enabled = enabled.contains(ProfileKey(system, mod.path));
+        mods.push_back(std::move(mod));
+      }
+    }
+  };
+  add_mods(user_directory / "Load" / "GraphicMods", false);
+  if (!sys_directory.empty())
+    add_mods(sys_directory / "Load" / "GraphicMods", true);
+  std::ranges::stable_sort(mods, {}, [](const GraphicsMod &mod) {
+    return std::pair(mod.system, mod.title);
+  });
+  return mods;
+}
+
+bool SaveGraphicsModSelection(const fs::path &user_directory,
+                              std::string_view game_id,
+                              const std::vector<GraphicsMod> &mods,
+                              std::string *error) {
+  const fs::path path = ProfilePath(user_directory, game_id);
+  picojson::value root;
+  if (!ReadJson(path, &root) || !root.is<picojson::object>())
+    root = picojson::value(picojson::object());
+  picojson::object &object = root.get<picojson::object>();
+  if (!object["mods"].is<picojson::array>())
+    object["mods"] = picojson::value(picojson::array());
+  picojson::array &entries = object["mods"].get<picojson::array>();
+
+  for (const GraphicsMod &mod : mods) {
+    const std::string key = ProfileKey(mod.system, mod.path);
+    const auto existing = std::ranges::find_if(entries, [&](const picojson::value &entry) {
+      return entry.get("path").is<std::string>() &&
+             ProfileKey(entry.get("source").to_str() == "system",
+                        entry.get("path").get<std::string>()) == key;
+    });
+    if (existing != entries.end() && existing->is<picojson::object>()) {
+      existing->get<picojson::object>()["enabled"] = picojson::value(mod.enabled);
+      continue;
+    }
+    picojson::object entry;
+    entry["source"] = picojson::value(mod.system ? "system" : "user");
+    entry["path"] = picojson::value(mod.path);
+    entry["enabled"] = picojson::value(mod.enabled);
+    entries.emplace_back(std::move(entry));
+  }
+
+  std::error_code create_error;
+  fs::create_directories(path.parent_path(), create_error);
+  std::ofstream file(path, std::ios::trunc);
+  file << root.serialize(true);
+  if (!file) {
+    if (error)
+      *error = "can't write " + path.string();
+    return false;
+  }
+  return true;
+}
+const char *ModKindName(ModKind kind) {
+  return kind == ModKind::TexturePack ? "Texture pack" : "Graphics mod";
+}
+
+std::optional<ModKind> DetectModKind(const fs::path &folder) {
+  std::error_code error;
+  bool textures = false;
+  for (auto it = fs::recursive_directory_iterator(folder, kScanOptions, error);
+       !error && it != fs::recursive_directory_iterator(); it.increment(error)) {
+    const fs::path &file = it->path();
+    if (file.filename() == "metadata.json")
+      return ModKind::GraphicsMod;
+    const std::string name = file.filename().string();
+    textures |= name.starts_with("tex1_") &&
+                (file.extension() == ".png" || file.extension() == ".dds");
+  }
+  if (textures)
+    return ModKind::TexturePack;
+  return std::nullopt;
+}
+
+std::vector<ModFolder> LoadModFolders(const fs::path &user_directory,
+                                      std::string_view game_id) {
+  std::vector<ModFolder> mods;
+  std::ifstream file(ModListPath(user_directory));
+  std::string line;
+  // Each line: on|off <tab> textures|graphics <tab> absolute path
+  while (std::getline(file, line)) {
+    const std::size_t first = line.find('\t');
+    const std::size_t second = line.find('\t', first + 1);
+    if (first == std::string::npos || second == std::string::npos)
+      continue;
+    ModFolder mod;
+    mod.enabled = line.substr(0, first) == "on";
+    mod.kind = line.substr(first + 1, second - first - 1) == "graphics"
+                   ? ModKind::GraphicsMod
+                   : ModKind::TexturePack;
+    mod.path = line.substr(second + 1);
+    mods.push_back(std::move(mod));
+  }
+  for (const ModKind kind : {ModKind::TexturePack, ModKind::GraphicsMod}) {
+    std::error_code error;
+    for (const auto &entry :
+         fs::directory_iterator(LoadFolder(user_directory, game_id, kind), error)) {
+      std::error_code type_error;
+      if (entry.is_symlink(type_error) || !entry.is_directory(type_error))
+        continue;
+      mods.push_back({.path = entry.path(), .kind = kind, .in_load_folder = true});
+    }
+  }
+  return mods;
+}
+
+bool SaveModFolders(const fs::path &user_directory,
+                    const std::vector<ModFolder> &mods, std::string *error) {
+  const fs::path path = ModListPath(user_directory);
+  std::error_code create_error;
+  fs::create_directories(path.parent_path(), create_error);
+  std::ofstream file(path, std::ios::trunc);
+  for (const ModFolder &mod : mods) {
+    if (!mod.in_load_folder)
+      file << (mod.enabled ? "on" : "off") << '\t'
+           << (mod.kind == ModKind::GraphicsMod ? "graphics" : "textures") << '\t'
+           << mod.path.string() << '\n';
+  }
+  if (!file) {
+    if (error)
+      *error = "can't write " + path.string();
+    return false;
+  }
+  return true;
+}
+
+bool MoveToModLibrary(const fs::path &user_directory, ModFolder *mod,
+                      std::string *error) {
+  const fs::path library = user_directory / "Mods";
+  std::error_code fs_error;
+  fs::create_directories(library, fs_error);
+  const fs::path destination = FreeName(library, mod->path.filename());
+  fs::rename(mod->path, destination, fs_error);
+  if (fs_error) {
+    if (error)
+      *error = "can't move " + mod->path.string() + ": " + fs_error.message();
+    return false;
+  }
+  mod->path = destination;
+  mod->in_load_folder = false;
+  return true;
+}
+
+bool ApplyModFolders(const fs::path &user_directory, std::string_view game_id,
+                     const std::vector<ModFolder> &mods, bool *textures_active,
+                     bool *graphics_mods_active, std::string *error) {
+  for (const ModKind kind : {ModKind::TexturePack, ModKind::GraphicsMod}) {
+    const fs::path folder = LoadFolder(user_directory, game_id, kind);
+    std::error_code fs_error;
+    fs::create_directories(folder, fs_error);
+    // Links are only ever made by the launcher; real folders are left alone.
+    for (const auto &entry : fs::directory_iterator(folder, fs_error)) {
+      std::error_code link_error;
+      if (entry.is_symlink(link_error))
+        fs::remove(entry.path(), link_error);
+    }
+  }
+  for (const ModFolder &mod : mods) {
+    std::error_code fs_error;
+    if (!mod.enabled || mod.in_load_folder || !fs::is_directory(mod.path, fs_error))
+      continue;
+    const fs::path link =
+        FreeName(LoadFolder(user_directory, game_id, mod.kind), mod.path.filename());
+    fs::create_directory_symlink(mod.path, link, fs_error);
+    if (fs_error) {
+      if (error)
+        *error = "can't link " + mod.path.string() + ": " + fs_error.message();
+      return false;
+    }
+  }
+
+  std::error_code fs_error;
+  *textures_active =
+      !fs::is_empty(LoadFolder(user_directory, game_id, ModKind::TexturePack), fs_error) &&
+      !fs_error;
+  // Anything in the game's graphics mod folder is wanted on, so enable all.
+  std::vector<GraphicsMod> graphics_mods = ListGraphicsMods(user_directory, {}, game_id);
+  for (GraphicsMod &mod : graphics_mods)
+    mod.enabled = true;
+  *graphics_mods_active = !graphics_mods.empty();
+  return graphics_mods.empty() ||
+         SaveGraphicsModSelection(user_directory, game_id, graphics_mods, error);
+}
+} // namespace moderngekko::frontend
