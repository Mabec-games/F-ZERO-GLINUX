+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "92210000 0023DA10\n"
+      "86200000 00000005\n"
+      "94210000 0023DA10\n"
+      "E0000000 80008000\n"
+      "$All Staff Ghosts Unlocked [Ralf]\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "1423DA00 03FFFFFF\n"
+      "E0000000 80008000\n"
+      "$All Story Mode Chapters & Finale Movies Unlocked [Ralf]\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "92110000 0023DA06\n"
+      "86200000 000001FF\n"
+      "94110000 0023DA06\n"
+      "1423DA08 FFFFFFFF\n"
+      "E0000000 80008000\n";
+
+  constexpr std::string_view kPalUnlockDefs =
+      "$Max Tickets (99,999)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "142486E0 0001869F\n"
+      "E0000000 80008000\n"
+      "$All Machines Unlocked (AX + Dark Schneider)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "14243E00 000001FF\n"
+      "14243E04 FFFFFFFF\n"
+      "E0000000 80008000\n"
+      "$All Custom Parts Unlocked (Gold Parts included)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "14243E08 FFFFFFFF\n"
+      "14243E0C FFFFFFFF\n"
+      "14243E14 000007FF\n"
+      "E0000000 80008000\n"
+      "$All Cups Unlocked (AX Cup included)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "92210000 002486EC\n"
+      "86200000 FC000000\n"
+      "94210000 002486EC\n"
+      "E0000000 80008000\n"
+      "$Sounds of MUTE CITY & BIG BLUE for Sale\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "92210000 002486F8\n"
+      "86200000 00000005\n"
+      "94210000 002486F8\n"
+      "E0000000 80008000\n"
+      "$All Staff Ghosts Unlocked [Ralf]\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "142486E8 03FFFFFF\n"
+      "E0000000 80008000\n"
+      "$All Story Mode Chapters & Finale Movies Unlocked [Ralf]\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "92110000 002486EE\n"
+      "86200000 000001FF\n"
+      "94110000 002486EE\n"
+      "142486F0 FFFFFFFF\n"
+      "E0000000 80008000\n";
+
+  const std::vector<std::string> unlock_codes = {
+      "$Max Tickets (99,999)",
+      "$All Machines Unlocked (AX + Dark Schneider)",
+      "$All Custom Parts Unlocked (Gold Parts included)",
+      "$All Cups Unlocked (AX Cup included)",
+      "$Sounds of MUTE CITY & BIG BLUE for Sale",
+      "$All Staff Ghosts Unlocked [Ralf]",
+      "$All Story Mode Chapters & Finale Movies Unlocked [Ralf]",
+  };
+  // Names written by earlier launcher builds; dropped so they cannot linger.
+  const std::vector<std::string> legacy_codes = {
+      "$All Custom Parts Available",
+      "$Unlock AX Cup Tracks",
+      "$All Vehicles Unlocked",
+  };
+  // Builds before v0.9.2 wrote "$$Name"; Dolphin then keeps the second '$' in
+  // the code name and never matches it under [Gecko_Enabled]. Collapse any
+  // run of leading '$' so those lines are recognised and rewritten.
+  auto format_gecko_header = [](std::string_view name) -> std::string {
+    const auto first = name.find_first_not_of('$');
+    return "$" + std::string(first == std::string_view::npos ? std::string_view{}
+                                                             : name.substr(first));
+  };
+  auto gecko_name_without_creator = [&](std::string_view name) -> std::string {
+    std::string s = format_gecko_header(name).substr(1);
+    const auto bracket = s.find('[');
+    if (bracket != std::string::npos) {
+      s = s.substr(0, bracket);
+    }
+    return "$" + Trim(s);
+  };
+  const auto is_managed = [&](const std::string &raw_name) {
+    const std::string name = format_gecko_header(raw_name);
+    if (std::ranges::find(unlock_codes, name) != unlock_codes.end() ||
+        std::ranges::find(legacy_codes, name) != legacy_codes.end()) {
+      return true;
+    }
+    for (const auto &c : unlock_codes) {
+      if (gecko_name_without_creator(c) == name)
+        return true;
+    }
+    return std::ranges::any_of(supported_local, [&](const LocalGeckoCodeOption &opt) {
+      return format_gecko_header(opt.ini_name) == name ||
+             gecko_name_without_creator(opt.ini_name) == name;
+    });
+  };
+  // Action Replay codes from earlier builds that freeze the intro screens.
+  const std::vector<std::string> dangerous_ar_codes = {
+      "$Max Tickets (99,999)",
+      "$Unlock AX Cup Tracks",
+      "$All Vehicles Unlocked",
+      "$All Custom Parts Available",
+  };
