+bool EnsureCheatsConfigured(const fs::path &user_directory,
+                            bool unlocks_enabled,
+                            std::span<const std::string> local_gecko_codes,
+                            bool allow_local_gecko_codes,
+                            std::string *error) {
+  const auto &supported_local = SupportedLocalGeckoCodes();
+  std::vector<const LocalGeckoCodeOption *> active_local_options;
+  if (allow_local_gecko_codes) {
+    for (const std::string &raw_id : local_gecko_codes) {
+      const std::string id = Lower(Trim(raw_id));
+      for (const LocalGeckoCodeOption &opt : supported_local) {
+        if (opt.id == id &&
+            std::ranges::find(active_local_options, &opt) ==
+                active_local_options.end()) {
+          active_local_options.push_back(&opt);
+          break;
+        }
+      }
+    }
+  }
+  const bool any_cheats_enabled =
+      unlocks_enabled || !active_local_options.empty();
+
+  // 1. Update user Config/Dolphin.ini Core section EnableCheats
+  const fs::path dolphin_ini_path = user_directory / "Config" / "Dolphin.ini";
+  if (fs::exists(dolphin_ini_path)) {
+    std::ifstream in(dolphin_ini_path);
+    std::string content, line, section;
+    bool found_enable_cheats = false;
+    while (std::getline(in, line)) {
+      std::string trimmed = Trim(line);
+      if (trimmed.starts_with('[') && trimmed.ends_with(']')) {
+        if (section == "[Core]" && !found_enable_cheats) {
+          content += "EnableCheats = " +
+                     std::string(any_cheats_enabled ? "True" : "False") + "\n";
+          found_enable_cheats = true;
+        }
+        section = trimmed;
+      } else if (section == "[Core]" && trimmed.starts_with("EnableCheats")) {
+        line = "EnableCheats = " +
+               std::string(any_cheats_enabled ? "True" : "False");
+        found_enable_cheats = true;
+      }
+      content += line + "\n";
+    }
+    if (section == "[Core]" && !found_enable_cheats) {
+      content += "EnableCheats = " +
+                 std::string(any_cheats_enabled ? "True" : "False") + "\n";
+    }
+    in.close();
+    std::ofstream out(dolphin_ini_path, std::ios::trunc);
+    out << content;
+  } else {
+    const fs::path config_dir = user_directory / "Config";
+    std::error_code dir_ec;
+    fs::create_directories(config_dir, dir_ec);
+    std::ofstream out(dolphin_ini_path, std::ios::trunc);
+    out << "[Core]\nEnableCheats = "
+        << (any_cheats_enabled ? "True" : "False") << "\n";
+  }
+
+  // 2. Update user GameSettings/GFZE01.ini (NTSC-U) and GFZP01.ini (PAL)
+  const fs::path gamesettings_dir = user_directory / "GameSettings";
+  std::error_code ec;
+  fs::create_directories(gamesettings_dir, ec);
+
+  // Every unlock code loads po from the OS module list head (0x800030C8, the
+  // main module's header; its address varies between boots), checks it, then
+  // writes the save fields in _Main.rel relative to po:
+  //   NTSC-U (GFZE01) / PAL (GFZP01, shifted by +0xACE8):
+  //   po+0x239118 / po+0x243E00 u64  machines available in the shop (ids 0-40)
+  //   po+0x239120 / po+0x243E08 u64  custom parts available, ids 0-63 (Gold Parts included)
+  //   po+0x239128 / po+0x243E10 u64  custom parts available, ids 64-74
+  //   po+0x23D9F8 / po+0x2486E0 u32  tickets (the shop caps them at 99,999)
+  //   po+0x23DA00 / po+0x2486E8 u32  staff ghosts unlocked
+  //   po+0x23DA04 / po+0x2486EC u32  cups unlocked & story chapters unlocked
+  //   po+0x23DA08 / po+0x2486F0 u32  master class & finale movies unlocked
+  //   po+0x23DA10 / po+0x2486F8 u32  shop songs, 0x1 and 0x4 = Sounds of MUTE CITY / BIG BLUE
+  constexpr std::string_view kNtscUnlockDefs =
+      "$Max Tickets (99,999)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "1423D9F8 0001869F\n"
+      "E0000000 80008000\n"
+      "$All Machines Unlocked (AX + Dark Schneider)\n"
