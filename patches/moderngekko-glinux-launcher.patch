 std::optional<std::string> HashFileSha256(const std::filesystem::path& path)
 {
+#if defined(_WIN32) && defined(_MSC_VER)
+  // Every launch hashes the whole extracted game (about 1.4 GB). CNG uses the
+  // CPU's SHA extensions where present, which made this roughly four times
+  // faster than the portable implementation on a Pentium Silver J5040.
+  std::ifstream file(path, std::ios::binary);
+  if (!file)
+    return std::nullopt;
+  BCRYPT_HASH_HANDLE hash = nullptr;
+  if (!BCRYPT_SUCCESS(BCryptCreateHash(BCRYPT_SHA256_ALG_HANDLE, &hash, nullptr, 0,
+                                       nullptr, 0, 0)))
+    return std::nullopt;
+  std::vector<char> buffer(1 << 20);
+  bool ok = true;
+  while (ok && file)
+  {
+    file.read(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+    const auto count = file.gcount();
+    if (count > 0)
+      ok = BCRYPT_SUCCESS(BCryptHashData(hash, reinterpret_cast<PUCHAR>(buffer.data()),
+                                         static_cast<ULONG>(count), 0));
+  }
+  std::array<UCHAR, 32> digest{};
+  ok = ok && file.eof() &&
+       BCRYPT_SUCCESS(BCryptFinishHash(hash, digest.data(),
+                                       static_cast<ULONG>(digest.size()), 0));
+  BCryptDestroyHash(hash);
+  if (!ok)
+    return std::nullopt;
+  std::ostringstream out;
+  out << std::hex << std::setfill('0');
+  for (const auto byte : digest)
+    out << std::setw(2) << static_cast<unsigned>(byte);
+  return out.str();
+#else
   auto bytes = ReadFileBytes(path);
   if (!bytes)
     return std::nullopt;
   return Sha256(std::move(*bytes));
+#endif
 }
 
