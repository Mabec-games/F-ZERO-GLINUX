+bool EnsureCheatsConfigured(const fs::path &user_directory, bool enabled,
+                            std::string *error) {
+  // 1. Update user Config/Dolphin.ini Core section EnableCheats
+  const fs::path dolphin_ini_path = user_directory / "Config" / "Dolphin.ini";
+  if (fs::exists(dolphin_ini_path)) {
+    std::ifstream in(dolphin_ini_path);
+    std::string content, line, section;
+    bool found_enable_cheats = false;
+    while (std::getline(in, line)) {
+      std::string trimmed = Trim(line);
+      if (trimmed.starts_with('[') && trimmed.ends_with(']')) {
+        if (section == "[Core]" && !found_enable_cheats) {
+          content += "EnableCheats = " + std::string(enabled ? "True" : "False") + "\n";
+          found_enable_cheats = true;
+        }
+        section = trimmed;
+      } else if (section == "[Core]" && trimmed.starts_with("EnableCheats")) {
+        line = "EnableCheats = " + std::string(enabled ? "True" : "False");
+        found_enable_cheats = true;
+      }
+      content += line + "\n";
+    }
+    if (section == "[Core]" && !found_enable_cheats) {
+      content += "EnableCheats = " + std::string(enabled ? "True" : "False") + "\n";
+    }
+    in.close();
+    std::ofstream out(dolphin_ini_path, std::ios::trunc);
+    out << content;
+  } else {
+    const fs::path config_dir = user_directory / "Config";
+    std::error_code dir_ec;
+    fs::create_directories(config_dir, dir_ec);
+    std::ofstream out(dolphin_ini_path, std::ios::trunc);
+    out << "[Core]\nEnableCheats = " << (enabled ? "True" : "False") << "\n";
+  }
+
+  // 2. Update user GameSettings/GFZE01.ini
+  const fs::path gamesettings_dir = user_directory / "GameSettings";
+  std::error_code ec;
+  fs::create_directories(gamesettings_dir, ec);
+  const fs::path gfz_ini_path = gamesettings_dir / "GFZE01.ini";
+
+  // Every code loads po from the OS module list head (0x800030C8, the main
+  // module's header; its address varies between boots), checks it, then writes
+  // the save fields the F-Zero Shop button cheats set, relative to po:
+  //   po+0x239118 u64  machines available in the shop (ids 0-40)
+  //   po+0x239120 u64  custom parts available, ids 0-63 (Gold Parts included)
+  //   po+0x239128 u64  custom parts available, ids 64-74
+  //   po+0x23DA04 u32  cups unlocked, bit 0x80000000 >> cup (cups 0-5), OR-ed
+  //   po+0x23DA10 u32  shop songs, 0x1 and 0x4 = Sounds of MUTE CITY / BIG BLUE
+  //   po+0x23D9F8 u32  tickets (the shop caps them at 99,999)
+  // No button sequence has to be entered in the shop.
+  constexpr std::string_view kGeckoDefs =
+      "$Max Tickets (99,999)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "1423D9F8 0001869F\n"
+      "E0000000 80008000\n"
+      "$All Machines Unlocked (AX + Dark Schneider)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "14239118 000001FF\n"
+      "1423911C FFFFFFFF\n"
+      "E0000000 80008000\n"
+      "$All Custom Parts Unlocked (Gold Parts included)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "14239120 FFFFFFFF\n"
+      "14239124 FFFFFFFF\n"
+      "1423912C 000007FF\n"
+      "E0000000 80008000\n"
+      "$All Cups Unlocked (AX Cup included)\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "92210000 0023DA04\n"
+      "86200000 FC000000\n"
+      "94210000 0023DA04\n"
+      "E0000000 80008000\n"
+      "$Sounds of MUTE CITY & BIG BLUE for Sale\n"
+      "48000000 800030C8\n"
+      "DE000000 80008180\n"
+      "92210000 0023DA10\n"
+      "86200000 00000005\n"
+      "94210000 0023DA10\n"
+      "E0000000 80008000\n";
+  const std::vector<std::string> gecko_codes = {
+      "$Max Tickets (99,999)",
+      "$All Machines Unlocked (AX + Dark Schneider)",
+      "$All Custom Parts Unlocked (Gold Parts included)",
+      "$All Cups Unlocked (AX Cup included)",
+      "$Sounds of MUTE CITY & BIG BLUE for Sale"
+  };
+  // Names written by earlier launcher builds; dropped so they cannot linger.
+  const std::vector<std::string> legacy_codes = {
+      "$All Custom Parts Available",
+      "$Unlock AX Cup Tracks",
+      "$All Vehicles Unlocked"
+  };
+  const auto is_managed = [&](const std::string &name) {
+    return std::ranges::find(gecko_codes, name) != gecko_codes.end() ||
+           std::ranges::find(legacy_codes, name) != legacy_codes.end();
+  };
+  // Action Replay codes from earlier builds that freeze the intro screens.
+  const std::vector<std::string> dangerous_ar_codes = {
+      "$Max Tickets (99,999)",
+      "$Unlock AX Cup Tracks",
+      "$All Vehicles Unlocked",
+      "$All Custom Parts Available"
+  };
+
+  // Rebuild the file, dropping our code definitions and enable entries (the
+  // current set is written back below) and keeping everything else as is.
+  std::string content, line, section;
+  bool skipping_code = false;
+  if (fs::exists(gfz_ini_path)) {
+    std::ifstream in(gfz_ini_path);
+    while (std::getline(in, line)) {
+      const std::string trimmed = Trim(line);
+      if (trimmed.starts_with('[') && trimmed.ends_with(']')) {
+        section = trimmed;
+        skipping_code = false;
+      } else if (section == "[Gecko]") {
+        if (trimmed.starts_with('$')) skipping_code = is_managed(trimmed);
+        if (skipping_code) continue;
+      } else if (section == "[Gecko_Enabled]" && is_managed(trimmed)) {
+        continue;
+      } else if (section == "[ActionReplay_Enabled]" &&
+                 std::ranges::find(dangerous_ar_codes, trimmed) !=
+                     dangerous_ar_codes.end()) {
+        continue;
+      }
+      content += line + "\n";
+    }
+  }
+
+  const auto insert_after_header = [&](std::string_view header,
+                                       const std::string &text) {
+    const std::string header_line = std::string(header) + "\n";
+    const auto pos = content.starts_with(header_line)
+                         ? 0
+                         : content.find("\n" + header_line);
+    if (pos == std::string::npos) {
+      if (!content.empty() && !content.ends_with('\n')) content += '\n';
+      content += header_line + text;
+    } else {
+      content.insert(pos + (pos == 0 ? 0 : 1) + header_line.size(), text);
+    }
+  };
+  insert_after_header("[Gecko]", std::string(kGeckoDefs));
+  if (enabled) {
+    std::string names;
+    for (const auto &c : gecko_codes) names += c + "\n";
+    insert_after_header("[Gecko_Enabled]", names);
+  }
+
+  std::ofstream out(gfz_ini_path, std::ios::trunc);
+  out << content;
+  if (!out) {
+    if (error) *error = "cannot write " + gfz_ini_path.string();
+    return false;
+  }
+  return true;
+}
+
+bool PatchRelGoldCheats(const fs::path &game_root, bool single_player,
+                        std::string *error) {
+  const fs::path rel_path = game_root / "files" / "fze.customize.rel";
+  if (!fs::exists(rel_path))
+    return true;
+
+  std::ifstream in(rel_path, std::ios::binary);
+  if (!in) {
+    if (error) *error = "cannot open " + rel_path.string();
+    return false;
+  }
+  std::vector<std::uint8_t> bytes((std::istreambuf_iterator<char>(in)), {});
+  in.close();
+
+  constexpr std::size_t kTableStart = 0x2e7f4;
+  if (bytes.size() < kTableStart + 5 * 36) {
+    if (error) *error = "fze.customize.rel is too small";
+    return false;
+  }
+
+  bool changed = false;
+  for (std::size_t i = 0; i < 5; ++i) {
+    const std::size_t code_start = kTableStart + i * 36;
+    for (std::size_t j = 0; j < 8; ++j) {
+      const std::size_t pos = code_start + j * 4;
+      const std::uint32_t w = (static_cast<std::uint32_t>(bytes[pos]) << 24) |
+                              (static_cast<std::uint32_t>(bytes[pos + 1]) << 16) |
+                              (static_cast<std::uint32_t>(bytes[pos + 2]) << 8) |
+                              bytes[pos + 3];
+      if ((w >> 24) != 0x01) continue;
+      const std::uint8_t mask = bytes[pos + 3] & 0x0f;
+      if (single_player && mask == 0x0f) {
+        bytes[pos + 3] = (bytes[pos + 3] & 0xf0) | 0x01;
+        changed = true;
+      } else if (!single_player && mask == 0x01) {
+        bytes[pos + 3] = (bytes[pos + 3] & 0xf0) | 0x0f;
+        changed = true;
+      }
+    }
+  }
+
+  if (changed) {
+    const fs::path tmp = rel_path.string() + ".tmp";
+    std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+    if (!out) {
+      if (error) *error = "cannot write temporary " + tmp.string();
+      return false;
+    }
+    out.write(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+    out.close();
+    std::error_code rename_ec;
+    fs::rename(tmp, rel_path, rename_ec);
+    if (rename_ec) {
+      if (error) *error = "cannot replace fze.customize.rel: " + rename_ec.message();
+      return false;
+    }
+  }
+  return true;
+}
