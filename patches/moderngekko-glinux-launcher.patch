+namespace moderngekko::frontend {
+// Medium weight with whole-pixel glyph placement keeps light text on the dark
+// panels crisp; the regular weight at 17 px rendered thin and soft.
+inline void AddLauncherFont(ImGuiIO &io) {
+  namespace fs = std::filesystem;
+  ImFontConfig font_config;
+  font_config.PixelSnapH = true;
+  for (const fs::path directory : {fs::path(SDL_GetBasePath()) / "Assets",
+                                   fs::path("/usr/share/fonts/noto"),
+                                   fs::path("/usr/share/fonts/truetype/noto"),
+                                   fs::path("/usr/share/fonts/google-noto")}) {
+    for (const char *name : {"NotoSans-Medium.ttf", "NotoSans-Regular.ttf"}) {
+      const fs::path font = directory / name;
+      if (fs::is_regular_file(font) &&
+          io.Fonts->AddFontFromFileTTF(font.string().c_str(), 18, &font_config))
+        return;
+    }
+  }
+}
+
+// The launcher's blue-on-navy colours, shared with the netplay lobby.
+inline void ApplyLauncherColors(ImGuiStyle &style) {
+  style.FrameRounding = 8;
+  style.Colors[ImGuiCol_WindowBg] = ImVec4(.025f, .045f, .08f, .96f);
+  style.Colors[ImGuiCol_Button] = ImVec4(.04f, .26f, .34f, 1);
+  style.Colors[ImGuiCol_FrameBg] = ImVec4(.07f, .12f, .18f, 1);
+  style.Colors[ImGuiCol_Header] = ImVec4(.03f, .35f, .43f, 1);
+  style.Colors[ImGuiCol_NavCursor] = ImVec4(0.1f, 0.95f, 1.0f, 1.0f);
+  style.Colors[ImGuiCol_ButtonHovered] = ImVec4(0.05f, 0.45f, 0.6f, 1.0f);
+  // Hints stay readable on the artwork.
+  style.Colors[ImGuiCol_TextDisabled] = ImVec4(.68f, .72f, .78f, 1);
+}
