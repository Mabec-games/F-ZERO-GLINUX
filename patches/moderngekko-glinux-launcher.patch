+#include "netplay_room_code.hpp"
+
+#include <array>
+#include <cctype>
+#include <vector>
+
+namespace moderngekko::frontend {
+namespace {
+// Order is part of the code format: changing it breaks codes between releases.
+constexpr std::array<std::string_view, 256> kWords{
+    "FALCON", "PICO", "SAMURAI", "GOROH", "ZODY", "JODY", "OCTOMAN", "HAWK",
+    "SHADOW", "ZODA", "DRAQ", "ROGER", "LEON", "NIGHTHAWK", "BEASTMAN", "ANTONIO",
+    "BABA", "KATE", "MUTE", "CITY", "BIGBLUE", "AEROPOLIS", "LIGHTNING", "PORTTOWN",
+    "SANDOCEAN", "FIREFIELD", "CASINO", "PALACE", "PHANTOM", "ROAD", "CYLINDER", "WAVE",
+    "SPLITOVAL", "TWIST", "DRIFT", "HIGHWAY", "LOOP", "HELIX", "JUMP", "SLIP",
+    "BOOST", "TURBO", "NITRO", "SPIN", "ATTACK", "BLAST", "BURST", "DASH",
+    "SURGE", "THRUST", "ROCKET", "JET", "GRIP", "LAP", "GRID", "POLE",
+    "APEX", "CHICANE", "PIT", "FLAG", "FINISH", "START", "PODIUM", "TROPHY",
+    "RUBY", "SAPPHIRE", "EMERALD", "DIAMOND", "GRANDPRIX", "STORY", "STAFF", "GHOST",
+    "TIME", "TRIAL", "NOVICE", "STANDARD", "EXPERT", "MASTER", "JACK", "QUEEN",
+    "KING", "CUP", "CROWN", "MEDAL", "GOLD", "SILVER", "BRONZE", "CHROME",
+    "STEEL", "IRON", "TITAN", "COBALT", "NEON", "PLASMA", "ION", "PHOTON",
+    "QUASAR", "PULSAR", "NEBULA", "COMET", "METEOR", "ORBIT", "GALAXY", "COSMOS",
+    "STAR", "NOVA", "VOID", "ZENITH", "NADIR", "ECLIPSE", "SOLAR", "LUNAR",
+    "ASTRO", "VECTOR", "VELOCITY", "MACH", "SONIC", "HYPER", "ULTRA", "MEGA",
+    "OMEGA", "ALPHA", "BETA", "GAMMA", "DELTA", "SIGMA", "THETA", "KAPPA",
+    "ZETA", "EPSILON", "LAMBDA", "OMICRON", "RHO", "TAU", "BLUE", "RED",
+    "GREEN", "YELLOW", "ORANGE", "PURPLE", "WHITE", "BLACK", "SCARLET", "CRIMSON",
+    "AZURE", "VIOLET", "AMBER", "JADE", "ONYX", "OPAL", "TOPAZ", "PEARL",
+    "QUARTZ", "GARNET", "IVORY", "EBONY", "CYAN", "MAGENTA", "STORM", "THUNDER",
+    "BOLT", "FLASH", "SPARK", "FLAME", "BLAZE", "INFERNO", "EMBER", "FROST",
+    "BLIZZARD", "CYCLONE", "TORNADO", "TYPHOON", "TEMPEST", "RAIN", "WIND", "GALE",
+    "ICE", "MAGMA", "LAVA", "VOLCANO", "CRATER", "CANYON", "DUNE", "DESERT",
+    "OASIS", "MESA", "RIDGE", "PEAK", "SUMMIT", "VALLEY", "RIVER", "HARBOR",
+    "BAY", "ISLAND", "REEF", "TIDE", "CORAL", "LAGOON", "FJORD", "GLACIER",
+    "TUNDRA", "JUNGLE", "FOREST", "MEADOW", "PRAIRIE", "TIGER", "LION", "PANTHER",
+    "JAGUAR", "WOLF", "FOX", "EAGLE", "RAVEN", "CONDOR", "VIPER", "COBRA",
+    "DRAGON", "PHOENIX", "GRIFFIN", "HYDRA", "KRAKEN", "SHARK", "ORCA", "MANTA",
+    "SCORPION", "HORNET", "WASP", "STALLION", "BLADE", "ARROW", "LANCE", "SABER",
+    "SPEAR", "SHIELD", "ARMOR", "CANNON", "LASER", "RAIL", "PIXEL", "MATRIX",
+    "CIRCUIT", "ENGINE", "PISTON", "GEAR", "TORQUE", "PILOT", "RACER", "RIVAL",
+    "CHAMPION", "LEGEND", "HERO", "ACE", "ZERO", "VORTEX", "SPRINT", "FUSION"};
+
+int HexValue(char c) {
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  return -1;
+}
+
+int WordIndex(std::string_view word) {
+  for (std::size_t i = 0; i < kWords.size(); ++i) {
+    const std::string_view candidate = kWords[i];
+    if (candidate.size() != word.size())
+      continue;
+    bool equal = true;
+    for (std::size_t j = 0; j < word.size() && equal; ++j)
+      equal = std::toupper(static_cast<unsigned char>(word[j])) == candidate[j];
+    if (equal)
+      return static_cast<int>(i);
+  }
+  return -1;
+}
+
+bool IsSeparator(char c) {
+  return c == ' ' || c == '-' || c == '_' || c == '\t';
+}
+} // namespace
+
+std::optional<std::string> EncodeRoomCode(std::string_view host_code) {
+  if (host_code.size() != 8)
+    return std::nullopt;
+  std::string result;
+  for (std::size_t i = 0; i < host_code.size(); i += 2) {
+    const int high = HexValue(host_code[i]);
+    const int low = HexValue(host_code[i + 1]);
+    if (high < 0 || low < 0)
+      return std::nullopt;
+    if (!result.empty())
+      result += '-';
+    result += kWords[static_cast<std::size_t>(high * 16 + low)];
+  }
+  return result;
+}
+
+std::optional<std::string> DecodeRoomCode(std::string_view room_code) {
+  std::vector<std::string_view> words;
+  std::size_t start = 0;
+  for (std::size_t i = 0; i <= room_code.size(); ++i) {
+    if (i < room_code.size() && !IsSeparator(room_code[i]))
+      continue;
+    if (i > start)
+      words.push_back(room_code.substr(start, i - start));
+    start = i + 1;
+  }
+  if (words.size() != 4)
+    return std::nullopt;
+
+  constexpr std::string_view kHex = "0123456789abcdef";
+  std::string host_code;
+  for (const std::string_view word : words) {
+    const int index = WordIndex(word);
+    if (index < 0)
+      return std::nullopt;
+    host_code += kHex[static_cast<std::size_t>(index / 16)];
+    host_code += kHex[static_cast<std::size_t>(index % 16)];
+  }
+  return host_code;
+}
+} // namespace moderngekko::frontend
