+      *message = std::move(text);
+    return false;
+  };
+#ifndef MODERNGEKKO_GAMECUBE_CONTROLLERS
+  return fail("steering wheels need the GameCube controller build");
+#endif
+  if (config.wheel_device.empty() ||
+      config.wheel_device.find_first_of("\r\n") != std::string::npos)
+    return fail("select a connected steering wheel");
+  if (!ValidWheelAxis(config.wheel_steering) ||
+      config.wheel_steering.starts_with("Full ") ||
+      !ValidWheelAxis(config.wheel_gas) || !ValidWheelAxis(config.wheel_brake))
+    return fail("steering wheel axes must look like \"Axis 0+\"");
+  const fs::path destination = ControllerConfigPath(user_directory);
+  std::error_code ec;
+  fs::create_directories(destination.parent_path(), ec);
+  if (ec)
+    return fail("can't create controller config directory: " + ec.message());
+  std::ofstream output(destination, std::ios::trunc);
+  if (!output)
+    return fail("can't write " + destination.string());
+  // Dolphin's wheel device reads steering from the main stick X axis, the
+  // accelerator from main stick up and the brake from C-stick up, so both
+  // pedals can be held together. The wheel's force commands drive
+  // Rumble/Motor; a constant effect turns them into force feedback.
+  const std::string &steer = config.wheel_steering;
+  const std::string axis = steer.substr(0, steer.size() - 1);
+  const char right = steer.back(), left = right == '+' ? '-' : '+';
+  output << "[GCPad1]\n"
+         << "Device = " << config.wheel_device << '\n'
+         << "Main Stick/Left = `" << axis << left << "`\n"
+         << "Main Stick/Right = `" << axis << right << "`\n"
+         << "Main Stick/Up = `" << config.wheel_gas << "`\n"
+         << "Main Stick/Dead Zone = 0.00\n"
+         << "Main Stick/Calibration = 100.00\n"
+         << "C-Stick/Up = `" << config.wheel_brake << "`\n"
+         // Button numbers follow the common Logitech layout; other wheels
+         // can be rebound in GCPadNew.ini.
+         << "Buttons/A = `Button 0`\n"
+            "Buttons/B = `Button 1`\n"
+            "Buttons/X = `Button 2`\n"
+            "Buttons/Y = `Button 3`\n"
+            "Buttons/Z = `Button 6` | `Button 7`\n"
+            "Buttons/Start = `Button 9`\n"
+            "Triggers/L = `Button 5`\n"
+            "Triggers/R = `Button 4`\n"
+            "Triggers/L-Analog = `Button 5`\n"
+            "Triggers/R-Analog = `Button 4`\n"
+            "D-Pad/Up = `Hat 0 N`\n"
+            "D-Pad/Down = `Hat 0 S`\n"
+            "D-Pad/Left = `Hat 0 W`\n"
+            "D-Pad/Right = `Hat 0 E`\n"
+         << "Rumble/Motor = Constant\n"
+         // The same -100% range Dolphin's mapping UI uses to flip the pull.
+         << (config.wheel_force_reverse ? "Rumble/Motor/Range = -100.00\n" : "")
+         << "[GCPad2]\n[GCPad3]\n[GCPad4]\n";
+  if (!output)
+    return fail("can't write " + destination.string());
+  if (message)
+    *message = "steering wheel mapped to port 1 (experimental)";
+  return true;
+}
