+}
+
+Artwork LoadArtwork(SDL_Renderer* renderer, const fs::path& path, bool crop = false) {
+  Artwork art;
+  std::ifstream file(path, std::ios::binary);
+  std::vector<u8> bytes((std::istreambuf_iterator<char>(file)), {});
+  Common::UniqueBuffer<u8> pixels;
+  u32 w = 0, h = 0;
+  if (bytes.empty() || !Common::LoadPNG(bytes, &pixels, &w, &h)) { std::cerr << "Artwork decode failed: " << path << "\n"; return art; }
+  if (!crop) for (size_t i = 3; i < size_t(w)*h*4; i += 4) pixels.data()[i] = 255;
+  art.texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_RGBA32, SDL_TEXTUREACCESS_STATIC, w, h);
+  if (!art.texture) return art;
+  SDL_UpdateTexture(art.texture, nullptr, pixels.data(), w * 4);
+  SDL_SetTextureBlendMode(art.texture, SDL_BLENDMODE_BLEND);
+  SDL_SetTextureScaleMode(art.texture, SDL_SCALEMODE_LINEAR);
+  art.width = w; art.height = h;
+  if (crop) {
+    u32 x0 = w, y0 = h, x1 = 0, y1 = 0;
+    for (u32 y = 0; y < h; ++y) for (u32 x = 0; x < w; ++x)
+      if (pixels.data()[(y * w + x) * 4 + 3] > 16) {
+        x0 = std::min(x0, x); y0 = std::min(y0, y);
+        x1 = std::max(x1, x + 1); y1 = std::max(y1, y + 1);
+      }
+    if (x1 > x0 && y1 > y0) {
+      art.uv0 = ImVec2(float(x0)/w, float(y0)/h);
+      art.uv1 = ImVec2(float(x1)/w, float(y1)/h);
+      art.width = x1-x0; art.height = y1-y0;
+    }
+  }
+  return art;
+}
+
+void DrawBackdrop(const Artwork& logo) {
+  const auto* vp = ImGui::GetMainViewport();
+  const float w = vp->WorkSize.x, h = vp->WorkSize.y;
+  const ImVec2 origin = vp->WorkPos;
+  auto* draw = ImGui::GetBackgroundDrawList();
+  draw->AddRectFilled(origin, ImVec2(origin.x+w,origin.y+h), IM_COL32(3,9,20,65));
+  draw->AddRectFilled(ImVec2(origin.x,origin.y+h-115), ImVec2(origin.x+w,origin.y+h), IM_COL32(3,9,20,235));
+  const float hero = w > 900 ? w * .43f : w;
+  if (logo.texture) {
+    const float lw = hero-56, lh = lw*logo.height/logo.width;
+    draw->AddImage((ImTextureID)(intptr_t)logo.texture, ImVec2(origin.x+28,origin.y+38),
+                  ImVec2(origin.x+28+lw,origin.y+38+lh), logo.uv0,logo.uv1);
+  }
+  draw->AddLine(ImVec2(origin.x+28,origin.y+h-106), ImVec2(origin.x+hero-28,origin.y+h-106), IM_COL32(0,224,240,255),2);
+  if (w > 900) {
+    draw->AddText(ImVec2(origin.x+28,origin.y+h-85), IM_COL32(96,232,244,255), "YOUR MACHINE. YOUR RACE.");
+    draw->AddText(ImVec2(origin.x+28,origin.y+h-58), IM_COL32(210,220,234,255), "F-ZERO GLINUX  /  FOR LINUX & WINDOWS");
+  }
+}
