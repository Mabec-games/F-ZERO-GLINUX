+namespace moderngekko::frontend {
+struct GraphicsMod {
+  std::string title;
+  std::string author;
+  std::string description;
+  bool system = false;
+  // Path below Load/GraphicMods (user) or Sys/Load/GraphicMods (system), as
+  // Dolphin stores it in Config/GraphicMods/<game id>.json.
+  std::string path;
+  bool enabled = false;
+};
+
+std::filesystem::path
+TexturePackDirectory(const std::filesystem::path &user_directory,
+                     std::string_view game_id);
+std::filesystem::path
+GraphicsModDirectory(const std::filesystem::path &user_directory,
+                     std::string_view game_id);
+
+// Finds the graphics mods Dolphin would offer for this game, with their
+// enabled state from the game's graphics mod profile.
+std::vector<GraphicsMod>
+ListGraphicsMods(const std::filesystem::path &user_directory,
+                 const std::filesystem::path &sys_directory,
+                 std::string_view game_id);
+// Writes the enabled state back to the profile, keeping any per-mod settings
+// Dolphin stored there.
+bool SaveGraphicsModSelection(const std::filesystem::path &user_directory,
+                              std::string_view game_id,
+                              const std::vector<GraphicsMod> &mods,
+                              std::string *error);
+
+enum class ModKind { TexturePack, GraphicsMod };
+
+// A mod folder the player picked. The folder stays where it is; enabling it
+// links it into Dolphin's Load folder for the game.
+struct ModFolder {
+  std::filesystem::path path;
+  ModKind kind = ModKind::TexturePack;
+  bool enabled = true;
+  // A real folder inside Dolphin's Load folder (installed by hand), not a link.
+  bool in_load_folder = false;
+};
+
+// Texture packs hold tex1_* .png/.dds files; graphics mods a metadata.json.
+std::optional<ModKind> DetectModKind(const std::filesystem::path &folder);
+const char *ModKindName(ModKind kind);
+
+std::vector<ModFolder> LoadModFolders(const std::filesystem::path &user_directory,
+                                      std::string_view game_id);
+bool SaveModFolders(const std::filesystem::path &user_directory,
+                    const std::vector<ModFolder> &mods, std::string *error);
+// Moves a folder installed by hand out of Dolphin's Load folder into the mod
+// library so it can be switched off.
+bool MoveToModLibrary(const std::filesystem::path &user_directory, ModFolder *mod,
+                      std::string *error);
+// Relinks the enabled folders and enables their graphics mods. Reports
+// whether any texture pack or graphics mod is active.
+bool ApplyModFolders(const std::filesystem::path &user_directory,
+                     std::string_view game_id, const std::vector<ModFolder> &mods,
+                     bool *textures_active, bool *graphics_mods_active,
+                     std::string *error);
+} // namespace moderngekko::frontend
