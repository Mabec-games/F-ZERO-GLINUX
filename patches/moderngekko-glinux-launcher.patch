+    if (!moderngekko::frontend::SaveConfig(directory, kb_cfg, &error) ||
+        !moderngekko::frontend::GenerateControllerConfig(directory, kb_devs, &error))
+      return 94;
+    if (!read_profile().contains("Buttons/X = `C`\nButtons/Y = `S`\n"))
+      return 95;
+    if (!moderngekko::frontend::SetBoostLayout(directory, true, &error) ||
+        !read_profile().contains("Buttons/X = `S`\nButtons/Y = `C`\n"))
+      return 96;
+    if (!moderngekko::frontend::SetBoostLayout(directory, false, &error) ||
+        !read_profile().contains("Buttons/X = `C`\nButtons/Y = `S`\n"))
+      return 97;
+  }
+
+  // Texture pack linking (symlink or NTFS directory junction on Windows without admin).
+  {
+    const fs::path ext_tex = directory / "ExternalTexPack";
+    fs::create_directories(ext_tex);
+    {
+      std::ofstream tex(ext_tex / "tex1_128x128_deadbeef.png");
+      tex << "png";
+    }
+    if (moderngekko::frontend::DetectModKind(ext_tex) !=
+        moderngekko::frontend::ModKind::TexturePack)
+      return 98;
+    std::vector<moderngekko::frontend::ModFolder> mods = {
+        {.path = ext_tex,
+         .kind = moderngekko::frontend::ModKind::TexturePack,
+         .enabled = true}};
+    bool tex_active = false, gfx_active = false;
+    if (!moderngekko::frontend::SaveModFolders(directory, mods, &error) ||
+        !moderngekko::frontend::ApplyModFolders(directory, "GFZE01", mods,
+                                                &tex_active, &gfx_active, &error) ||
+        !tex_active || gfx_active)
+      return 99;
+    // Linked folder in Load/Textures/GFZE01 must not be misclassified as hand-installed.
+    const auto reloaded_mods =
+        moderngekko::frontend::LoadModFolders(directory, "GFZE01");
+    if (reloaded_mods.size() != 1 || reloaded_mods[0].in_load_folder)
+      return 100;
+    // Disabling the mod removes the link cleanly while keeping the source file intact.
+    mods[0].enabled = false;
+    if (!moderngekko::frontend::ApplyModFolders(directory, "GFZE01", mods,
+                                                &tex_active, &gfx_active, &error) ||
+        tex_active || !fs::exists(ext_tex / "tex1_128x128_deadbeef.png"))
+      return 101;
+  }
+#endif
+
   fs::remove_all(directory);
   return 0;
 }
diff --git a/tests/netplay_room_code_test.cpp b/tests/netplay_room_code_test.cpp
new file mode 100644
index 0000000..e07c356
--- /dev/null
+++ b/tests/netplay_room_code_test.cpp
@@ -0,0 +1,50 @@
+#include "netplay_room_code.hpp"
+
+#include <cstdio>
+#include <set>
+#include <string>
+
+namespace {
+bool Fail(const char *message) {
+  std::fprintf(stderr, "%s\n", message);
+  return false;
+}
+
+bool Run() {
+  std::set<std::string> first_words;
+  for (unsigned int byte = 0; byte < 256; ++byte) {
+    char host_code[9];
+    std::snprintf(host_code, sizeof(host_code), "%02x%02x%02x%02x", byte,
+                  255 - byte, (byte * 7) & 0xff, (byte * 13) & 0xff);
+    const auto encoded = moderngekko::frontend::EncodeRoomCode(host_code);
+    if (!encoded)
+      return Fail("valid host code was not encoded");
+    if (moderngekko::frontend::DecodeRoomCode(*encoded) != host_code)
+      return Fail("room code did not round-trip");
+    first_words.insert(encoded->substr(0, encoded->find('-')));
+  }
+  if (first_words.size() != 256)
+    return Fail("room code words are not unique");
+
+  const auto encoded = moderngekko::frontend::EncodeRoomCode("00ff10ab");
+  if (!encoded)
+    return Fail("example host code was not encoded");
+  std::string relaxed;
+  for (const char c : *encoded)
+    relaxed += c == '-' ? ' ' : static_cast<char>(c | 0x20);
+  if (moderngekko::frontend::DecodeRoomCode("  " + relaxed + " ") != "00ff10ab")
+    return Fail("lowercase, space-separated room code was rejected");
+
+  if (moderngekko::frontend::EncodeRoomCode("00ff10a") ||
+      moderngekko::frontend::EncodeRoomCode("00ff10ag"))
+    return Fail("malformed host code was encoded");
+  if (moderngekko::frontend::DecodeRoomCode("192.168.1.50") ||
+      moderngekko::frontend::DecodeRoomCode("localhost") ||
+      moderngekko::frontend::DecodeRoomCode("FALCON-PICO-SAMURAI") ||
+      moderngekko::frontend::DecodeRoomCode("FALCON-PICO-SAMURAI-NOTAWORD"))
+    return Fail("non-room-code text was decoded");
+  return true;
+}
+} // namespace
+
+int main() { return Run() ? 0 : 1; }
