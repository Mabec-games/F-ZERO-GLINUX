+bool InitializeWidescreenProfile(const fs::path &user_directory,
+                                const fs::path &seed, std::string *error) {
+  try {
+    // Never seed an existing profile, even if its card happens to be empty.
+    // Existing Config can contain custom/raw memory-card paths.
+    if (fs::exists(user_directory / "config.ini") ||
+        fs::exists(user_directory / "Config") ||
+        fs::exists(user_directory / "GC") || !fs::exists(seed))
+      return true;
+    std::array<char, 64> header{};
+    std::ifstream input(seed, std::ios::binary);
+    input.read(header.data(), header.size());
+    if (!input || std::string_view(header.data(), 6) != "GFZE8P" ||
+        std::string_view(header.data() + 8, 11) != std::string_view("f_zero.dat\0", 11) ||
+        static_cast<unsigned char>(header[0x38]) != 0 ||
+        static_cast<unsigned char>(header[0x39]) != 4 ||
+        fs::file_size(seed) != 64 + 4 * 8192) {
+      if (error) *error = "Invalid GFZE01 widescreen save template";
+      return false;
+    }
+    const auto card = user_directory / "GC" / "USA" / "Card A";
+    fs::create_directories(card);
+    const auto target = card / "8P-GFZE-f_zero.dat.gci";
+    // No overwrite option: a concurrent creation must fail safely.
+    fs::copy_file(seed, target, fs::copy_options::none);
+    ConfigResult config;
+    config.resolution = "1920x1080";
+    config.aspect_ratio = "16:9";
+    if (!SaveConfig(user_directory, config, error))
+      return false;
+    return true;
+  } catch (const fs::filesystem_error &e) {
+    if (error) *error = e.what();
+    return false;
+  }
+}
