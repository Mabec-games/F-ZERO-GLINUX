+int ConfirmExitDialog(bool online) {
+  if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) return 2;
+  auto* window = SDL_CreateWindow("F-ZERO GLINUX", 580, 260, SDL_WINDOW_ALWAYS_ON_TOP);
+  auto* renderer = window ? SDL_CreateRenderer(window, nullptr) : nullptr;
+  if (!renderer) { SDL_Quit(); return 2; }
+  ImGui::CreateContext();
+  auto& io = ImGui::GetIO();
+  io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad;
+  io.IniFilename = nullptr;
+  moderngekko::frontend::AddLauncherFont(io);
+  ImGui::StyleColorsDark();
+  ImGui::GetStyle().FramePadding = ImVec2(20,14);
+  ImGui::GetStyle().Colors[ImGuiCol_NavCursor] = ImVec4(0,1,1,1);
+  ImGui_ImplSDL3_InitForSDLRenderer(window, renderer);
+  ImGui_ImplSDLRenderer3_Init(renderer);
+  bool done = false, armed = false;
+  int result = 0;
+  const Uint64 started = SDL_GetTicks();
+  while (!done) {
+    SDL_Event event;
+    while (SDL_PollEvent(&event)) {
+      ImGui_ImplSDL3_ProcessEvent(&event);
+      if (event.type == SDL_EVENT_QUIT) done = true;
+    }
+    ImGui_ImplSDLRenderer3_NewFrame(); ImGui_ImplSDL3_NewFrame(); ImGui::NewFrame();
+    bool newly_armed = false;
+    if (!armed && SDL_GetTicks()-started > 300 &&
+        !ImGui::IsKeyDown(ImGuiKey_GamepadFaceDown) && !ImGui::IsKeyDown(ImGuiKey_GamepadFaceRight) &&
+        !ImGui::IsKeyDown(ImGuiKey_Enter) && !ImGui::IsKeyDown(ImGuiKey_Escape)) {
+      armed = true; newly_armed = true;
+    }
+    ImGui::SetNextWindowPos(ImVec2(0,0)); ImGui::SetNextWindowSize(io.DisplaySize);
+    ImGui::Begin("Exit", nullptr, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoSavedSettings);
+    ImGui::TextColored(ImVec4(0, .9f, 1, 1), "F-ZERO GLINUX");
+    ImGui::Spacing(); ImGui::TextUnformatted(online ? "Leave online session?" : "Exit the game?");
+    ImGui::TextWrapped("%s", online ? "The session keeps running. Leaving may interrupt other players." : "Progress not saved in-game will be lost. Choose No to resume.");
+    ImGui::Spacing(); ImGui::BeginDisabled(!armed);
+    // Show the focus on No from the start: ImGui keeps a programmatically set
+    // focus hidden, and a hidden focus ignores Enter / A until a direction is pressed.
+    if (newly_armed) { ImGui::SetKeyboardFocusHere(); ImGui::SetNavCursorVisible(true); }
+    if (ImGui::Button("No - resume", ImVec2(250,54))) done = true;
+    ImGui::SameLine();
+    if (ImGui::Button("Yes - exit", ImVec2(250,54))) { result = 10; done = true; }
+    ImGui::EndDisabled();
+    if (armed && (ImGui::IsKeyPressed(ImGuiKey_Escape) || ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight))) done = true;
+    ImGui::Spacing(); ImGui::TextDisabled("D-pad: select    A: confirm    B / Escape: resume");
+    ImGui::End(); ImGui::Render();
+    SDL_SetRenderDrawColor(renderer, 5,12,23,255); SDL_RenderClear(renderer);
+    ImGui_ImplSDLRenderer3_RenderDrawData(ImGui::GetDrawData(), renderer); SDL_RenderPresent(renderer);
+    SDL_Delay(16);
+  }
+  ImGui_ImplSDLRenderer3_Shutdown(); ImGui_ImplSDL3_Shutdown(); ImGui::DestroyContext();
+  SDL_DestroyRenderer(renderer); SDL_DestroyWindow(window); SDL_Quit();
+  return result;
+}
