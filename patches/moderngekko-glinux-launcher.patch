+  const auto write_game_ini = [&](const fs::path &ini_path,
+                                  std::string_view unlock_defs,
+                                  bool is_pal) -> bool {
+    std::string content, line, section;
+    bool skipping_code = false;
+    if (fs::exists(ini_path)) {
+      std::ifstream in(ini_path);
+      while (std::getline(in, line)) {
+        const std::string trimmed = Trim(line);
+        if (trimmed.starts_with('[') && trimmed.ends_with(']')) {
+          section = trimmed;
+          skipping_code = false;
+        } else if (section == "[Gecko]") {
+          if (trimmed.starts_with('$'))
+            skipping_code = is_managed(trimmed);
+          if (skipping_code)
+            continue;
+        } else if (section == "[Gecko_Enabled]" && is_managed(trimmed)) {
+          continue;
+        } else if (section == "[ActionReplay_Enabled]" &&
+                   std::ranges::find(dangerous_ar_codes, trimmed) !=
+                       dangerous_ar_codes.end()) {
+          continue;
+        }
+        content += line + "\n";
+      }
+    }
+
+    std::string all_defs(unlock_defs);
+    for (const LocalGeckoCodeOption &opt : supported_local) {
+      const std::string_view body = is_pal ? opt.pal_body : opt.ntsc_u_body;
+      if (body.empty())
+        continue;
+      all_defs += format_gecko_header(opt.ini_name) + "\n";
+      all_defs += body;
+      if (!all_defs.ends_with('\n'))
+        all_defs += '\n';
+    }
+
+    const auto insert_after_header = [&](std::string_view header,
+                                         const std::string &text) {
+      const std::string header_line = std::string(header) + "\n";
+      const auto pos = content.starts_with(header_line)
+                           ? 0
+                           : content.find("\n" + header_line);
+      if (pos == std::string::npos) {
+        if (!content.empty() && !content.ends_with('\n'))
+          content += '\n';
+        content += header_line + text;
+      } else {
+        content.insert(pos + (pos == 0 ? 0 : 1) + header_line.size(), text);
+      }
+    };
+    insert_after_header("[Gecko]", all_defs);
+
+    std::string enabled_names;
+    const auto append_enabled_entry = [&](const std::string &raw_entry) {
+      const std::string full = format_gecko_header(raw_entry);
+      const std::string stripped = gecko_name_without_creator(raw_entry);
+      enabled_names += full + "\n";
+      if (stripped != full) {
+        enabled_names += stripped + "\n";
+      }
+    };
+    if (unlocks_enabled) {
+      for (const auto &c : unlock_codes)
+        append_enabled_entry(c);
+    }
+    for (const LocalGeckoCodeOption *opt : active_local_options) {
+      const std::string_view body = is_pal ? opt->pal_body : opt->ntsc_u_body;
+      if (!body.empty())
+        append_enabled_entry(std::string(opt->ini_name));
+    }
+    if (!enabled_names.empty()) {
+      insert_after_header("[Gecko_Enabled]", enabled_names);
+    }
+
+    if (is_pal) {
+      if (!content.contains("[Core]")) {
+        content = "[Core]\nPAL60 = True\n" + content;
+      } else if (!content.contains("PAL60")) {
+        insert_after_header("[Core]", "PAL60 = True\n");
+      }
+    }
+
+    std::ofstream out(ini_path, std::ios::trunc);
+    out << content;
+    if (!out) {
+      if (error)
+        *error = "cannot write " + ini_path.string();
+      return false;
+    }
+    return true;
+  };
+
+  if (!write_game_ini(gamesettings_dir / "GFZE01.ini", kNtscUnlockDefs, false))
+    return false;
+  if (!write_game_ini(gamesettings_dir / "GFZP01.ini", kPalUnlockDefs, true))
+    return false;
+  return true;
+}
