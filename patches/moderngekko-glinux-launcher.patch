+    ImGui::Spacing(); ImGui::BeginDisabled(!armed);
+    if (newly_armed) ImGui::SetKeyboardFocusHere();
+    if (ImGui::Button("No - resume", ImVec2(250,54))) done = true;
+    ImGui::SameLine();
+    if (ImGui::Button("Yes - exit", ImVec2(250,54))) { result = 10; done = true; }
+    ImGui::EndDisabled();
+    if (armed && (ImGui::IsKeyPressed(ImGuiKey_Escape) || ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight))) done = true;
+    ImGui::Spacing(); ImGui::TextDisabled("D-pad: select    A: confirm    B / Escape: resume");
+    ImGui::End(); ImGui::Render();
+    SDL_SetRenderDrawColor(renderer, 5,12,23,255); SDL_RenderClear(renderer);
+    ImGui_ImplSDLRenderer3_RenderDrawData(ImGui::GetDrawData(), renderer); SDL_RenderPresent(renderer);
+    SDL_Delay(16);
+  }
+  ImGui_ImplSDLRenderer3_Shutdown(); ImGui_ImplSDL3_Shutdown(); ImGui::DestroyContext();
+  SDL_DestroyRenderer(renderer); SDL_DestroyWindow(window); SDL_Quit();
+  return result;
+}
