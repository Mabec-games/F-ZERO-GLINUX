+bool EnsureSteeringWheelPort(const fs::path &user_directory, bool enabled,
+                             std::string *error) {
+  // Dolphin's SIDevices: 6 = standard controller, 8 = steering wheel.
+  constexpr std::string_view controller = "6", wheel = "8";
+  const fs::path path = user_directory / "Config" / "Dolphin.ini";
+  std::string content, line;
+  bool in_core = false, written = false;
+  const std::string wanted(enabled ? wheel : controller);
+  if (std::ifstream in(path); in) {
+    while (std::getline(in, line)) {
+      const std::string trimmed = Trim(line);
+      if (trimmed.starts_with('[') && trimmed.ends_with(']')) {
+        if (in_core && !written && enabled) {
+          content += "SIDevice0 = " + wanted + "\n";
+          written = true;
+        }
+        in_core = trimmed == "[Core]";
+      } else if (in_core) {
+        const auto equals = trimmed.find('=');
+        if (equals != std::string::npos &&
+            Trim(trimmed.substr(0, equals)) == "SIDevice0") {
+          if (!enabled && Trim(trimmed.substr(equals + 1)) != wheel)
+            return true;
+          line = "SIDevice0 = " + wanted;
+          written = true;
+        }
+      }
+      content += line + "\n";
+    }
+  }
+  if (!written) {
+    if (!enabled)
+      return true;
+    // Reached only when [Core] is missing or is the last section.
+    content += (in_core ? "" : "[Core]\n") + std::string("SIDevice0 = ") + wanted + "\n";
+  }
+  std::error_code ec;
+  fs::create_directories(path.parent_path(), ec);
+  std::ofstream out(path, std::ios::trunc);
+  out << content;
+  if (!out) {
+    if (error)
+      *error = "cannot write " + path.string();
+    return false;
+  }
+  return true;
+}
