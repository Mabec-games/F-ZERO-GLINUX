+bool ValidWheelAxis(std::string_view value) {
+  // "Full Axis" spans the whole axis, for pedals that rest at one end.
+  if (value.starts_with("Full "))
+    value.remove_prefix(5);
+  constexpr std::string_view prefix = "Axis ";
+  if (!value.starts_with(prefix) || value.size() < prefix.size() + 2 ||
+      value.size() > prefix.size() + 3)
+    return false;
+  const std::string_view digits =
+      value.substr(prefix.size(), value.size() - prefix.size() - 1);
+  return std::ranges::all_of(digits, [](char c) { return c >= '0' && c <= '9'; }) &&
+         (value.back() == '+' || value.back() == '-');
+}
